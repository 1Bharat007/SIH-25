# ==============================================================================
# Sikkim Yatra Monorepo - Global Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (apps/server)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
API_PREFIX=/api/v1

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sikkim_yatra_dev?schema=public"

# JWT Secret (for future authentication / tour guide & admin permits)
JWT_SECRET="super-secret-sikkim-yatra-jwt-dev-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Frontend Web Configuration (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME="Sikkim Yatra"
NEXT_PUBLIC_APP_DESCRIPTION="Smart Offline-First Digital Tourism Platform for Sikkim"
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_MAPBOX_TOKEN=""
